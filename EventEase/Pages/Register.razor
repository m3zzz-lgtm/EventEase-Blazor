@page "/register"
@using EventEase.Models
@using EventEase.Services
@inject AppState State
@inject NavigationManager NavManager

<PageTitle>Event Registration</PageTitle>

<h3>Register for an Event</h3>

@if (isSubmitted)
{
    <div class="alert alert-success">
        Thank you, <strong>@regModel.FullName</strong>! Registration successful.
    </div>
}

<EditForm Model="@regModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Full Name</label>
        <InputText class="form-control" @bind-Value="regModel.FullName" />
        <ValidationMessage For="@(() => regModel.FullName)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="regModel.Email" />
        <ValidationMessage For="@(() => regModel.Email)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Event</label>
        <InputSelect class="form-select" @bind-Value="regModel.SelectedEvent">
            <option value="">-- Select an Event --</option>
            <option value="Tech Summit">Tech Summit 2026</option>
            <option value="AI Workshop">AI Workshop</option>
        </InputSelect>
        <ValidationMessage For="@(() => regModel.SelectedEvent)" />
    </div>

    <button type="submit" class="btn btn-primary">Submit Registration</button>
</EditForm>

@code {
    private RegistrationModel regModel = new();
    private bool isSubmitted = false;

    private void HandleValidSubmit()
    {
        isSubmitted = true;
        State.IncrementAttendance();
        State.SetUser(regModel.FullName);
    }
}
